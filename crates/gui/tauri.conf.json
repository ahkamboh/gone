{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gone",
  "version": "0.1.0",
  "identifier": "com.gone.privacy",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "gone",
        "width": 800,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 }
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  }
}
